@model Project_CarRental.Models.Rental

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Thông tin chi tiết đặt xe</h2>
    </div>
    <div class="container shadow p-5">
        <form method="post" asp-action="Edit">
            <div asp-validation-summary="All"></div>
			<div class="form-row">
                <div class="row">
                    <div class="col-sm-3">
                        <h5 class="mb-3">Thông tin khách hàng</h5>
                        <div class="form-group">
                            <label asp-for="RentalID">Mã đặt xe</label>
                            <input type="text" class="form-control mb-3" asp-for="RentalID" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="FullName">Tên khách hàng</label>
                            <input type="text" class="form-control mb-3" asp-for="FullName" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="Phone">Số điện thoại</label>
                            <input type="text" class="form-control mb-3" asp-for="Phone" disabled>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <h5 class="mb-3">Thông tin đặt xe</h5>
                        <div class="form-group">
                            <label asp-for="CarName">Tên xe đặt</label>
                            <input type="text" class="form-control mb-3" asp-for="CarName" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="PickUpLocation">Điểm đón</label>
                            <input type="text" class="form-control mb-3" asp-for="PickUpLocation" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="DropOffLocation">Điểm trả</label>
                            <input type="text" class="form-control mb-3" asp-for="DropOffLocation" disabled>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <h5 class="mb-3">Thời gian</h5>
                        <div class="form-group">
                            <label asp-for="PickUpDate">Ngày đón</label>
                            <input type="text" class="form-control mb-3" asp-for="PickUpDate" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="PickUpTime">Thời gian đón</label>
                            <input type="text" class="form-control mb-3" asp-for="PickUpTime" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="DropOffDate">Ngày trả</label>
                            <input type="text" class="form-control mb-3" asp-for="DropOffDate" disabled>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <h5 class="mb-3">Thông tin khác</h5>
                        <div class="form-group">
                            <label asp-for="Status">Trạng thái đặt xe</label>
                            <input type="text" class="form-control mb-3" asp-for="Status" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="CreateDate">Ngày đặt xe</label>
                            <input type="text" class="form-control mb-3" asp-for="CreateDate" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="TotalAmount">Tổng tiền</label>
                            <input type="text" class="form-control mb-3" asp-for="TotalAmount" disabled>
                        </div>
                    </div>
                </div>
			</div>
            <a href="javascript:history.back()" class="btn btn-lg btn-warning p-2 mr-5">
                <i class="bi bi-arrow-left-circle"></i> Quay lại
            </a>
            <a asp-area="Admin" asp-controller="Rental" asp-action="Contract" asp-route-id="@Model.RentalID"
               class="btn btn-lg btn-primary p-2 mr-5" title="Hợp đồng">
                <i class="bi bi-file-earmark-text"></i> Hợp đồng
            </a>
        </form>
    </div>
</main>
