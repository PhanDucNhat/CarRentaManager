													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													(98%)
												</span>
												<span>20 đánh giá</span>
											</p>
											<p class="star">
												<span>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													(85%)
												</span>
												<span>10 đánh giá</span>
											</p>
											<p class="star">
												<span>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													(70%)
												</span>
												<span>5 đánh giá</span>
											</p>
											<p class="star">
												<span>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													(10%)
												</span>
												<span>0 đánh giá</span>
											</p>
											<p class="star">
												<span>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													<i class="ion-ios-star"></i>
													(0%)
												</span>
												<span>0 đánh giá</span>
											</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

