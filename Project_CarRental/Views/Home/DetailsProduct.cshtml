<section class="ftco-section" style="padding: 2em 0;">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-12 heading-section text-center ftco-animate mb-5">
				<h2 class="mb-2">Đặt xe</h2>
			</div>
		</div>
		<div class="row">
			<div class="col-md-8">
				<form action="@Url.Action("BookCar", "Rental")" method="post" class="request-form ftco-animate bg-primary">
					<h2 class="text-center">Chuyến đi của bạn</h2>

					<input type="hidden" name="ProductID" value="@Model.ProductID" />
					<input type="hidden" name="total_amount" id="totalAmount" value="0">

					<div class="form-group position-relative">
						<label for="" class="label">Địa điểm đón</label>
						<div class="input-group">
							<input type="text" name="pickup_location" class="form-control" placeholder="Thành phố, sân bay, nhà ga, etc" required>
							<span class="input-group-text" style="cursor: pointer;" onclick="openGoogleMap()">
								<i class="fas fa-map-marker-alt" style="color: #0984e3;"></i>
							</span>
						</div>
					</div>
					<div class="form-group position-relative">
						<label for="" class="label">Địa điểm trả</label>
						<div class="input-group">
							<input type="text" name="dropoff_location" class="form-control" placeholder="Thành phố, sân bay, nhà ga, etc" required>
							<span class="input-group-text" style="cursor: pointer;" onclick="openGoogleMap()">
								<i class="fas fa-map-marker-alt" style="color: #0984e3;"></i>
							</span>
						</div>
					</div>
					<div class="d-flex">
						<div class="form-group mr-2">
							<label for="" class="label">Ngày đón</label>
							<input type="date" name="pick_up_date" class="form-control" id="pickUpDate" required>
						</div>
						<div class="form-group ml-2">
							<label for="" class="label">Ngày trả</label>
							<input type="date" name="drop_off_date" class="form-control" id="dropOffDate" required>
						</div>
						<div class="form-group ml-2">
							<label for="" class="label">Thời gian đón</label>
							<input type="time" name="pick_up_time" class="form-control" required>
						</div>
					</div>
					<div class="form-group">
						<input type="submit" value="Đặt xe ngay bây giờ" class="btn btn-secondary py-3 px-4">
					</div>
				</form>
			</div>

			<div class="col-md-4">
				<div class="categories p-4 rounded" style="background: #fff; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
					<h3 class="mb-4 text-center" style="color: #0984e3; font-weight: bold; font-size: 1.4em;">Phí</h3>
					<ul class="list-unstyled">
						<li class="d-flex justify-content-between py-2">
							<span>Thuê ngày</span>
							<span class="font-weight-bold" id="pricePerDay">@Html.Raw(Model.PricesDay) vnd/ngày</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Bảo hiểm thuê xe</span>
							<span class="font-weight-bold" id="insuranceFee">50,000 vnd</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Mã khuyến mại</span>
							<span class="font-weight-bold">
								<select id="promoCode" class="form-control" style="max-width: 180px; display: inline-block;">
									<option value="0">Chọn</option>
									<option value="10000">- 10,000 VND</option>
									<option value="20000">- 20,000 VND</option>
									<option value="30000">- 30,000 VND</option>
								</select>
							</span>
						</li>
					</ul>
					<div id="calculationFormula" class="mb-2 font-weight-bold" style="font-size: 1em; color: #7f8c8d; text-align: right;"></div>

					<div class="total-amount mt-3 font-weight-bold text-right" style="font-size: 1.2em; color: #e17055;">
						Tổng tiền: <span id="totalPrice" style="color: red;">0 vnd</span>
					</div>
				</div>

				<div class="categories p-4 rounded mt-4" style="background: #fff; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
					<h3 class="mb-4 text-center" style="color: #d63031; font-weight: bold; font-size: 1.4em;">Phụ phí phát sinh</h3>
					<ul class="list-unstyled">
						<li class="d-flex justify-content-between py-2">
							<span>Thuê giờ</span>
							<span class="font-weight-bold">@Html.Raw(Model.PricesHour) vnd</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Ngoài giờ</span>
							<span class="font-weight-bold">@Html.Raw(Model.OverTime) vnd/giờ</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Vượt cây số</span>
							<span class="font-weight-bold">@Html.Raw(Model.ExceedKm) vnd/km</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Lưu đêm</span>
							<span class="font-weight-bold">@Html.Raw(Model.OverNight) vnd/đêm</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Chủ nhật-ngày lễ</span>
							<span class="font-weight-bold">@Html.Raw(Model.Holiday) vnd/ngày</span>
						</li>
						<li class="d-flex justify-content-between py-2">
							<span>Đường dài</span>
							<span class="font-weight-bold">@Html.Raw(Model.LongRoad)</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function openGoogleMap() {
		window.open("https://www.google.com/maps", "_blank");
	}

	document.addEventListener("DOMContentLoaded", function () {

		const pickUpDate = document.getElementById("pickUpDate");
		const dropOffDate = document.getElementById("dropOffDate");
		const pricePerDay = parseInt(document.getElementById("pricePerDay").textContent.replace(' vnd', '').replace(',', ''), 10);
		const insuranceFee = 50000;
		const totalPriceElement = document.getElementById("totalPrice");
		const totalAmountInput = document.getElementById("totalAmount");
		const calculationFormula = document.getElementById("calculationFormula");
		const promoCodeSelect = document.getElementById("promoCode");

		let total = 0;
		let discount = 0;

		function updateTotalPrice() {
			const pickUp = new Date(pickUpDate.value);
			const dropOff = new Date(dropOffDate.value);

			if (pickUp && dropOff && dropOff >= pickUp) {

				const timeDifference = dropOff - pickUp;
				const days = Math.ceil(timeDifference / (1000 * 3600 * 24));

				switch (promoCodeSelect.value) {
					case "10000":
						discount = 10000;
						break;
					case "20000":
						discount = 20000;
						break;
					case "30000":
						discount = 30000;
						break;
					default:
						discount = 0;
						break;
				}

				total = (days * pricePerDay) + insuranceFee - discount;

				totalPriceElement.textContent = total.toLocaleString() + " vnd";

				totalAmountInput.value = (total / 1000).toString();

				calculationFormula.textContent = `${pricePerDay.toLocaleString()} vnd X ${days} ngày`;

				console.log("Raw total:", total);
				console.log("Total amount to be saved:", totalAmountInput.value);
			} else {
				totalPriceElement.textContent = "0 vnd";
				totalAmountInput.value = "0";
				calculationFormula.textContent = "";
			}
		}

		pickUpDate.addEventListener("change", updateTotalPrice);
		dropOffDate.addEventListener("change", updateTotalPrice);
		promoCodeSelect.addEventListener("change", updateTotalPrice);
