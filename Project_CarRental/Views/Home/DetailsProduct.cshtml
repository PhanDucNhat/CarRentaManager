										<li class="check"><span class="ion-ios-checkmark"></span>Màn hình DVD</li>
									</ul>
								</div>
								<div class="col-md-4">
									<ul class="features">
										<li class="check"><span class="ion-ios-checkmark"></span>Bluetooth</li>
										<li class="remove"><span class="ion-ios-close"></span>Camera lùi</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Ghế trẻ em</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Camera 360</li>
										<li class="remove"><span class="ion-ios-close"></span>Cảm biến lốp</li>
									</ul>
								</div>
								<div class="col-md-4">
									<ul class="features">
										<li class="check"><span class="ion-ios-checkmark"></span>Khe cắm USB</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Túi khí an toàn</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Cảm biến va chạm</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Lốp dự phòng</li>
										<li class="check"><span class="ion-ios-checkmark"></span>Camera cập lề</li>
									</ul>
								</div>
							</div>
						</div>

						<div class="tab-pane fade" id="pills-manufacturer" role="tabpanel" aria-labelledby="pills-manufacturer-tab">
							<p class=" text-justify">@Html.Raw(Model.Description)</p>
						</div>

						<div class="tab-pane fade" id="pills-review" role="tabpanel" aria-labelledby="pills-review-tab">
							<div class="row">
								@await Component.InvokeAsync("EvaluateProduct", Model.ProductID)
